      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Sparziele"
          }
        }
      }
    },
    "All totals, budgets and reports use the base currency. Default is EUR. Expenses keep their original currency and amount.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Summen, Budgets und Auswertungen verwenden die Basiswährung. Standard ist EUR. Ausgaben behalten ihre ursprüngliche Währung und ihren Betrag."
          }
        }
      }
    },
    "Allow notifications": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen erlauben"
