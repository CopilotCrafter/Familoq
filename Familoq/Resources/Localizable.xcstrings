    "%lld foreign-currency expense(s) are waiting for an exchange rate and are not in the totals yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Ausgabe(n) in Fremdwährung warten auf einen Wechselkurs und sind noch nicht in den Summen."
          }
        }
      }
    },
    "%lld foreign-currency expense(s) are waiting for an exchange rate.": {
      "extractionState": "manual",
