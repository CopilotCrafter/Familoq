        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto des Rezepts auswählen"
          }
        }
      }
    },
    "Take a photo of the cookbook page with the Camera first. The text is read on this iPhone; check the ingredients and steps before saving.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere die Kochbuchseite zuerst mit der Kamera. Der Text wird auf diesem iPhone gelesen; prüfe Zutaten und Schritte vor dem Sichern."
          }
        }
      }
    },
    "No recipe found on this page. Try the photo import or type it in.": {
      "extractionState": "manual",
