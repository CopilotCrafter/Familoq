      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto konnte nicht geladen werden."
          }
        }
      }
    },
    "The receipt does not say clearly. Amounts in other currencies are converted to %@ with the exchange rate of the receipt date.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beleg ist nicht eindeutig. Beträge in anderen Währungen werden mit dem Kurs vom Belegdatum in %@ umgerechnet."
          }
        }
      }
    },
    "This backup was made by a newer Familoq. Please update Familoq first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sicherung stammt von einer neueren Familoq-Version. Bitte aktualisiere Familoq zuerst."
          }
        }
      }
    },
    "This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
