            "state": "translated",
            "value": "Organisation"
          }
        }
      }
    },
    "Familoq gives general guidance from common dietary recommendations - it is not medical advice. For kidney disease, type 1 diabetes, pregnancy or allergies, follow your doctor or dietitian.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Familoq gibt allgemeine Hinweise nach gängigen Ernährungsempfehlungen – das ist keine medizinische Beratung. Bei Nierenerkrankung, Typ-1-Diabetes, Schwangerschaft oder Allergien folge deiner Ärztin, deinem Arzt oder der Ernährungsberatung."
          }
        }
      }
    },
    "No conditions or allergies": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Erkrankungen oder Allergien"
          }
        }
      }
    },
