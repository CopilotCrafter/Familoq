    "Budgets and totals use this currency. Expenses in other currencies are converted automatically. You can change it later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Budgets und Summen verwenden diese Währung. Ausgaben in anderen Währungen werden automatisch umgerechnet. Du kannst sie später ändern."
          }
        }
      }
    },
    "Budgets are converted with today's ECB rate (rounded). Every expense is recalculated with the rate of its own date. Requires an internet connection.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Budgets werden mit dem heutigen EZB-Kurs umgerechnet (gerundet). Jede Ausgabe wird mit dem Kurs ihres eigenen Datums neu berechnet. Benötigt eine Internetverbindung."
          }
        }
      }
    },
