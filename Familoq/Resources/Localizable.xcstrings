          }
        }
      }
    },
    "Nuts & peanuts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüsse & Erdnüsse"
          }
        }
      }
    },
    "Egg": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei"
          }
        }
      }
    },
    "Shellfish": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeresfrüchte"
          }
        }
      }
    },
    "Soy": {
      "extractionState": "manual",
