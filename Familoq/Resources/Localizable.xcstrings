    "Adds the backup's records to this family; records that already exist are replaced by the backup's version. Other families are never changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt die Daten der Sicherung dieser Familie hinzu; bereits vorhandene Einträge werden durch die Version aus der Sicherung ersetzt. Andere Familien werden nie verändert."
          }
        }
      }
    },
