{
  "sourceLanguage": "en",
  "strings": {
    "\"Familoq in total\" covers all families on this iPhone; the photo lines are for %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Familoq gesamt“ umfasst alle Familien auf diesem iPhone; die Foto-Zeilen gelten für %@."
          }
        }
      }
    },
    "\"Make photos smaller\" re-saves large photos in grayscale (receipts stay readable). \"Keep receipt photos\" removes older photos automatically on your iPhone; the receipts stay. Mark a receipt with \"Keep photo\" for warranty or tax.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Fotos verkleinern“ speichert große Fotos in Graustufen neu (Belege bleiben lesbar). „Kassenbon-Fotos behalten“ entfernt ältere Fotos automatisch auf deinem iPhone; die Belege bleiben. Markiere einen Beleg mit „Foto behalten“ für Garantie oder Steuer."
          }
        }
      }
    },
    "%@ (general)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (allgemein)"
          }
        }
      }
    },
