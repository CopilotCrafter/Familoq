      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkohol"
          }
        }
      }
    },
    "Alert": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis"
          }
        }
      }
    },
    "Alerts are prepared on this iPhone from the family's data. iOS also checks for new family entries in the background now and then, so they can alert you without opening Familoq.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hinweise werden auf diesem iPhone aus den Familiendaten vorbereitet. iOS sieht ab und zu auch im Hintergrund nach neuen Einträgen, damit sie dich erreichen, ohne dass du Familoq öffnest."
          }
        }
      }
    },
    "Alerts go to the chosen people's iPhones. Everyone in the family sees the event.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise gehen an die iPhones der gewählten Personen. Alle in der Familie sehen den Termin."
          }
        }
      }
    },
