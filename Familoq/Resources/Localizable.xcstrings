        }
      }
    },
    "%lld of %lld members. Members add and edit their own expenses; the owner can allow a member more (tap the member). Tap your own name to change it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld Mitgliedern. Mitglieder fügen Ausgaben hinzu und bearbeiten ihre eigenen; der Inhaber kann einem Mitglied mehr erlauben (Mitglied antippen). Tippe auf deinen Namen, um ihn zu ändern."
          }
        }
      }
    },
    "%lld of %lld members. Owners manage members, settings, categories and budgets; members add and edit their own expenses.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld Mitgliedern. Inhaber verwalten Mitglieder, Einstellungen, Kategorien und Budgets; Mitglieder erfassen und bearbeiten ihre eigenen Ausgaben."
          }
        }
      }
    },
