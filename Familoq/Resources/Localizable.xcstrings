    "Adds the backup's records to this family; records that already exist are replaced by the backup's version. Other families are never changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt die Daten der Sicherung dieser Familie hinzu; bereits vorhandene Einträge werden durch die Version aus der Sicherung ersetzt. Andere Familien werden nie verändert."
          }
        }
      }
    },
    "Administration": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwaltung"
          }
        }
      }
    },
    "Alert": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis"
          }
        }
      }
    },
    "Alerts are prepared on this iPhone from the family's data. iOS also checks for new family entries in the background now and then, so they can alert you without opening Familoq.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hinweise werden auf diesem iPhone aus den Familiendaten vorbereitet. iOS sieht ab und zu auch im Hintergrund nach neuen Einträgen, damit sie dich erreichen, ohne dass du Familoq öffnest."
          }
        }
      }
    },
    "Alerts go to the chosen people's iPhones. Everyone in the family sees the event.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise gehen an die iPhones der gewählten Personen. Alle in der Familie sehen den Termin."
          }
        }
      }
    },
    "All budgets": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Budgets"
